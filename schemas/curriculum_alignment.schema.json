{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CurriculumAlignment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "alignment_id", "target_id", "curriculum_requirement_stable_id", "requirement_facet_stable_id", "standard_version", "alignment_type", "evidence_anchors", "confidence", "original_basis", "status", "review_status", "production_eligible"],
  "properties": {
    "schema_version": { "const": "curriculum-alignment.v1" },
    "record_type": { "const": "curriculum_alignment" },
    "alignment_id": { "type": "string", "minLength": 1 },
    "target_id": { "type": "string", "minLength": 1 },
    "curriculum_requirement_stable_id": { "type": "string", "minLength": 1 },
    "requirement_facet_stable_id": { "type": ["string", "null"], "minLength": 1 },
    "standard_version": { "type": "string", "minLength": 1 },
    "alignment_type": { "enum": ["source_cited", "contemporaneous_inferred", "retrospective_crosswalk"] },
    "evidence_anchors": { "type": "array", "minItems": 1, "items": { "$ref": "evidence_anchor.schema.json" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "original_basis": { "type": "boolean" },
    "status": { "enum": ["candidate", "reviewed", "active", "rejected"] },
    "review_status": { "enum": ["pending_review", "approved", "rejected"] },
    "production_eligible": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "original_basis": { "const": true } }, "required": ["original_basis"] },
      "then": { "properties": { "alignment_type": { "const": "source_cited" } } }
    },
    {
      "if": { "properties": { "alignment_type": { "enum": ["contemporaneous_inferred", "retrospective_crosswalk"] } }, "required": ["alignment_type"] },
      "then": { "properties": { "original_basis": { "const": false } } }
    },
    {
      "if": { "properties": { "status": { "const": "candidate" } }, "required": ["status"] },
      "then": { "properties": { "review_status": { "const": "pending_review" }, "production_eligible": { "const": false } } }
    },
    {
      "if": { "properties": { "production_eligible": { "const": true } }, "required": ["production_eligible"] },
      "then": { "properties": { "status": { "const": "active" }, "review_status": { "const": "approved" } } }
    }
  ]
}
