{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceAnchor",
  "description": "Traceable source reference projected from SourceDocument, SourceRegion, and SourceRegion.Metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_document_id",
    "source_region_id",
    "source_document_version",
    "source_document_sha256",
    "pdf_page_number",
    "printed_page_number",
    "section_path",
    "official_item_code",
    "text_block_sha256",
    "evidence_role"
  ],
  "properties": {
    "source_document_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "source_region_id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Null is allowed only while a candidate anchor has not yet been materialized as a SourceRegion."
    },
    "source_document_version": {
      "type": "string",
      "minLength": 1
    },
    "source_document_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "pdf_page_number": {
      "type": "integer",
      "minimum": 1
    },
    "printed_page_number": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "section_path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "official_item_code": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "text_block_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "evidence_role": {
      "type": "string",
      "enum": [
        "curriculum_requirement_source",
        "curriculum_facet_source",
        "question_stem_source",
        "answer_or_solution_source",
        "scoring_point_source",
        "performance_statistic_source",
        "error_observation_source",
        "teaching_recommendation_source"
      ]
    }
  }
}
