{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuestionItemSnapshot",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "subject",
    "stage",
    "question_type",
    "blocks",
    "status",
    "knowledge_mappings"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "grade": {
      "type": "string"
    },
    "question_type": {
      "type": "string"
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question_block"
      }
    },
    "answer": {
      "type": [
        "string",
        "object",
        "null"
      ]
    },
    "solution": {
      "type": [
        "string",
        "object",
        "null"
      ]
    },
    "status": {
      "type": "string"
    },
    "knowledge_mappings": {
      "type": "array"
    },
    "source_regions": {
      "type": "array"
    },
    "custom_fields": {
      "type": "object"
    }
  },
  "$defs": {
    "question_block": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "sourceRegionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "content": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "stableKey": {
              "type": "string",
              "minLength": 1
            },
            "scopeKey": {
              "type": "string",
              "pattern": "^question-scope:v1:"
            },
            "questionBlockId": {
              "type": "string",
              "format": "uuid"
            },
            "reviewStatus": {
              "type": "string"
            },
            "productionEligible": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
