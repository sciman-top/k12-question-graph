{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KQGBackupManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "createdAt",
    "database",
    "fileStore",
    "configsSnapshotRoot",
    "configs",
    "templatesSnapshotRoot",
    "templates"
  ],
  "properties": {
    "version": { "const": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "databaseName", "dump", "sha256"],
      "properties": {
        "engine": { "const": "postgresql" },
        "databaseName": { "type": "string", "minLength": 1 },
        "dump": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fileStore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotRoot", "files"],
      "properties": {
        "snapshotRoot": { "$ref": "#/$defs/relativePath" },
        "sourceRoot": { "type": "string" },
        "root": { "type": "string" },
        "files": { "$ref": "#/$defs/fileEntries" }
      }
    },
    "configsSnapshotRoot": { "$ref": "#/$defs/relativePath" },
    "configs": { "$ref": "#/$defs/fileEntries" },
    "templatesSnapshotRoot": { "$ref": "#/$defs/relativePath" },
    "templates": { "$ref": "#/$defs/fileEntries" },
    "evidenceSnapshotRoot": { "$ref": "#/$defs/relativePath" },
    "evidence": { "$ref": "#/$defs/fileEntries" }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:[A-Za-z]:|[\\\\/])" }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "fileEntries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/relativePath" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  }
}
