{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CropCandidateGenerationResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_document_id",
    "candidates",
    "review_required",
    "issues"
  ],
  "properties": {
    "source_document_id": { "type": "string" },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "page",
          "bbox",
          "region_type",
          "ownership",
          "confidence",
          "review_required",
          "issues"
        ],
        "properties": {
          "candidate_id": { "type": "string", "minLength": 1 },
          "page": { "type": "integer", "minimum": 1 },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "number" }
          },
          "region_type": {
            "type": "string",
            "enum": ["question", "shared_figure", "table", "formula", "material"]
          },
          "ownership": {
            "type": "string",
            "enum": ["question_owned", "shared_material", "unknown"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "review_required": { "type": "boolean" },
          "issues": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "review_required": { "type": "boolean" },
    "issues": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
