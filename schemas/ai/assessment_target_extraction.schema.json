{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssessmentTargetExtraction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "generation", "governance", "targets", "review_queue", "invariants"],
  "properties": {
    "schema_version": { "const": "assessment-target-extraction.v1" },
    "mode": { "const": "draft_test" },
    "generation": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "engine", "version", "external_model_calls"],
      "properties": {
        "method": { "enum": ["rules", "ai"] },
        "engine": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "external_model_calls": { "type": "integer", "minimum": 0 }
      }
    },
    "governance": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "review_status", "production_eligible", "database_write", "active_write"],
      "properties": {
        "status": { "const": "candidate" },
        "review_status": { "const": "pending_review" },
        "production_eligible": { "const": false },
        "database_write": { "const": false },
        "active_write": { "const": false }
      }
    },
    "targets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/target" } },
    "review_queue": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/review" } },
    "invariants": {
      "type": "object", "additionalProperties": false,
      "required": ["one_primary_per_scope", "all_scopes_covered", "all_pending_review", "ai_did_not_mutate_source_facts"],
      "properties": {
        "one_primary_per_scope": { "const": true },
        "all_scopes_covered": { "const": true },
        "all_pending_review": { "const": true },
        "ai_did_not_mutate_source_facts": { "const": true }
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["scope_key", "scope_type", "question_item_id", "question_block_id"],
      "properties": {
        "scope_key": { "type": "string", "pattern": "^question-scope:v1:" },
        "scope_type": { "enum": ["whole_question", "subquestion", "scoring_point"] },
        "question_item_id": { "type": "string", "format": "uuid" },
        "question_block_id": { "type": ["string", "null"], "format": "uuid" }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "generation_method", "source_kind", "confidence"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "generation_method": { "enum": ["rules", "ai"] },
        "source_kind": { "enum": ["explicit_fact", "derived_candidate", "not_inferred"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["target_id", "question_scope", "target_statement", "is_primary_target", "primary_knowledge_id", "curriculum_alignment_ids", "ability_dimensions", "cognitive_demands", "method_model_experiment_ids", "context_type", "representation_types", "task_type", "score_weight", "field_provenance", "evidence_refs", "confidence", "status", "review_status", "production_eligible"],
      "properties": {
        "target_id": { "type": "string", "minLength": 1 },
        "question_scope": { "$ref": "#/$defs/scope" },
        "target_statement": { "type": "string", "minLength": 1 },
        "is_primary_target": { "const": true },
        "primary_knowledge_id": { "type": ["string", "null"], "minLength": 1 },
        "curriculum_alignment_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "ability_dimensions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "cognitive_demands": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "method_model_experiment_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "context_type": { "type": "string", "minLength": 1 },
        "representation_types": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "task_type": { "type": "string", "minLength": 1 },
        "score_weight": { "type": ["number", "null"], "minimum": 0 },
        "field_provenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/provenance" } },
        "evidence_refs": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["source_document_id", "source_region_id", "role"],
            "properties": {
              "source_document_id": { "type": "string", "format": "uuid" },
              "source_region_id": { "type": "string", "format": "uuid" },
              "role": { "enum": ["question_stem_source", "answer_or_solution_source"] }
            }
          }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "const": "candidate" },
        "review_status": { "const": "pending_review" },
        "production_eligible": { "const": false }
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["target_id", "scope_key", "priority", "reasons", "status"],
      "properties": {
        "target_id": { "type": "string", "minLength": 1 },
        "scope_key": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["normal", "high", "blocked"] },
        "reasons": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "status": { "const": "pending_review" }
      }
    }
  }
}
