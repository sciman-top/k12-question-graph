{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaperCompositionReviewResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blueprint_id",
    "decision",
    "constraints",
    "selected_question_ids",
    "confidence",
    "review_required",
    "issues"
  ],
  "properties": {
    "blueprint_id": { "type": "string" },
    "decision": {
      "type": "string",
      "enum": ["feasible", "review", "block"]
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "details"],
        "properties": {
          "name": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["satisfied", "conflict", "unknown"]
          },
          "details": { "type": "string" }
        }
      }
    },
    "selected_question_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "review_required": { "type": "boolean" },
    "issues": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
