{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KnowledgeMappingSuggestion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_type",
    "source_id",
    "suggestions",
    "review_required",
    "reason"
  ],
  "$defs": {
    "curriculum_asset_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping_id",
        "source_asset_type",
        "source_stable_id",
        "parent_requirement_stable_id",
        "target_asset_type",
        "target_knowledge_code",
        "mapping_type",
        "match_basis",
        "matched_term",
        "confidence",
        "source_material_id",
        "evidence_anchor_sha256",
        "impact_scope",
        "review_status",
        "auto_apply_allowed",
        "rollback_required",
        "rollback_requirement",
        "review_reasons"
      ],
      "properties": {
        "mapping_id": { "type": "string", "pattern": "^MAP-CEK08-[A-F0-9]{16}$" },
        "source_asset_type": { "const": "requirement_facet" },
        "source_stable_id": { "type": "string", "minLength": 1 },
        "parent_requirement_stable_id": { "type": "string", "minLength": 1 },
        "target_asset_type": { "const": "knowledge_point" },
        "target_knowledge_code": { "type": "string", "minLength": 1 },
        "mapping_type": {
          "type": "string",
          "enum": ["equivalent", "broader", "narrower"]
        },
        "match_basis": {
          "type": "string",
          "enum": [
            "title_exact",
            "alias_exact",
            "title_contained_by_source",
            "alias_contained_by_source",
            "source_contained_by_title",
            "source_contained_by_alias"
          ]
        },
        "matched_term": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source_material_id": { "type": "string", "minLength": 1 },
        "evidence_anchor_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "impact_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "review_status": { "const": "pending_review" },
        "auto_apply_allowed": { "const": false },
        "rollback_required": { "const": true },
        "rollback_requirement": { "const": "discard_mapping_candidate" },
        "review_reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "one_to_many",
              "many_to_one",
              "low_confidence",
              "scope_direction_review",
              "high_impact_asset_mapping"
            ]
          }
        }
      }
    },
    "curriculum_knowledge_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_stable_id",
        "source_facet_stable_id",
        "parent_requirement_stable_id",
        "proposed_title",
        "proposed_node_type",
        "evidence_anchor_sha256s",
        "confidence",
        "status",
        "review_status",
        "production_eligible",
        "knowledge_node_write",
        "rollback_requirement",
        "reasons"
      ],
      "properties": {
        "candidate_stable_id": { "type": "string", "pattern": "^KCAN-[A-F0-9]{16}$" },
        "source_facet_stable_id": { "type": "string", "minLength": 1 },
        "parent_requirement_stable_id": { "type": "string", "minLength": 1 },
        "proposed_title": { "type": "string", "minLength": 1 },
        "proposed_node_type": { "const": "concept" },
        "evidence_anchor_sha256s": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 0.8 },
        "status": { "const": "candidate" },
        "review_status": { "const": "pending_review" },
        "production_eligible": { "const": false },
        "knowledge_node_write": { "const": false },
        "rollback_requirement": { "const": "discard_candidate_record" },
        "reasons": {
          "type": "array",
          "const": ["no_deterministic_title_or_alias_match"]
        }
      }
    }
  },
  "properties": {
    "source_type": {
      "type": "string",
      "enum": [
        "question",
        "textbook_chapter",
        "curriculum_standard",
        "region_exam_point"
      ]
    },
    "source_id": {
      "type": "string"
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "knowledge_id",
          "name",
          "mapping_type",
          "weight",
          "confidence"
        ],
        "properties": {
          "knowledge_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "mapping_type": {
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "prerequisite",
              "extension",
              "method",
              "misconception"
            ]
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "review_required": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    }
  }
}
