{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VisualAssetReviewResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_document_id",
    "assets",
    "review_required",
    "issues"
  ],
  "properties": {
    "source_document_id": { "type": "string" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "verdict", "confidence", "issues"],
        "properties": {
          "asset_id": { "type": "string", "minLength": 1 },
          "verdict": {
            "type": "string",
            "enum": ["pass", "review", "block"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "issues": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "review_required": { "type": "boolean" },
    "issues": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
