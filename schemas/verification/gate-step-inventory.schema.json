{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://k12-question-graph.local/schemas/verification/gate-step-inventory.schema.json",
  "title": "Legacy gate step inventory report",
  "type": "object",
  "required": ["schemaVersion", "status", "sourceScript", "sourceHash", "stepCount", "profileCounts", "steps"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "pass" },
    "sourceScript": { "type": "string", "minLength": 1 },
    "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stepCount": { "type": "integer", "minimum": 1 },
    "profileCounts": { "type": "object" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "command", "owner_module", "profile", "risk", "requires_database", "stops_process", "writes_repo", "writes_filestore", "requires_external_tool", "trigger_paths", "trigger_only", "supersedes", "evidence_output", "source_line", "automatable_repo_side"],
        "properties": {
          "id": { "type": "string", "pattern": "^legacy-[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "owner_module": { "type": "string", "minLength": 1 },
          "profile": { "enum": ["Quick", "Slice", "Release", "Onsite"] },
          "risk": { "enum": ["low", "medium", "high"] },
          "requires_database": { "type": "boolean" },
          "stops_process": { "type": "boolean" },
          "writes_repo": { "type": "boolean" },
          "writes_filestore": { "type": "boolean" },
          "requires_external_tool": { "type": "boolean" },
          "trigger_paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "trigger_only": { "type": "boolean" },
          "supersedes": { "type": "array", "items": { "type": "string" } },
          "evidence_output": { "type": "array", "items": { "type": "string" } },
          "source_line": { "type": "integer", "minimum": 1 },
          "automatable_repo_side": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
