{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://k12-question-graph.local/schemas/verification/evidence-index.schema.json",
  "title": "Curated current evidence index",
  "type": "object",
  "required": ["schemaVersion", "scope", "policy", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scope": { "const": "curated_current_only" },
    "policy": {
      "type": "object",
      "required": ["quickSliceRoot", "trackedRoot", "historicalDefault"],
      "properties": {
        "quickSliceRoot": { "const": "tmp/verification" },
        "trackedRoot": { "const": "docs/evidence" },
        "historicalDefault": { "const": "historical_unless_indexed_current" }
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "currentPath", "supersededPaths", "authorityLevel", "claimBoundary", "state"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "currentPath": { "type": "string", "pattern": "^docs/evidence/" },
          "supersededPaths": { "type": "array", "items": { "type": "string", "pattern": "^docs/evidence/" } },
          "authorityLevel": { "enum": ["repo-side", "release-side", "onsite-manual", "live-accepted"] },
          "claimBoundary": { "type": "string", "minLength": 1 },
          "state": { "const": "current" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
