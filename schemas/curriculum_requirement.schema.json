{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CurriculumRequirement",
  "description": "A versioned curriculum requirement with source-preserving requirement facets and fail-closed governance fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "stable_id",
    "parent_stable_id",
    "standard_version",
    "official_item_code",
    "requirement_type",
    "source_text",
    "behavior_verbs",
    "cognitive_demands",
    "ability_dimensions",
    "knowledge_stable_ids",
    "evidence_anchors",
    "confidence",
    "status",
    "review_status",
    "production_eligible",
    "facets"
  ],
  "properties": {
    "schema_version": {
      "const": "curriculum-requirement.v1"
    },
    "record_type": {
      "const": "curriculum_requirement"
    },
    "stable_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_stable_id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "standard_version": {
      "type": "string",
      "minLength": 1
    },
    "official_item_code": {
      "type": "string",
      "minLength": 1
    },
    "requirement_type": {
      "$ref": "#/$defs/requirement_type"
    },
    "source_text": {
      "type": "string",
      "minLength": 1,
      "description": "Verified verbatim curriculum text. A generated summary is not a substitute for this field."
    },
    "behavior_verbs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cognitive_demands": {
      "type": "array",
      "uniqueItems": true,
      "description": "Version-aware cognitive-demand identifiers; an empty candidate array is allowed before semantic extraction.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ability_dimensions": {
      "type": "array",
      "uniqueItems": true,
      "description": "Versioned AbilityDimension stable identifiers, not knowledge-node or question-type labels.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "knowledge_stable_ids": {
      "type": "array",
      "uniqueItems": true,
      "description": "KnowledgeNode mappings; empty until the separately reviewed crosswalk is available.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "evidence_anchor.schema.json"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "$ref": "#/$defs/lifecycle_status"
    },
    "review_status": {
      "$ref": "#/$defs/review_status"
    },
    "production_eligible": {
      "type": "boolean"
    },
    "facets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/requirement_facet"
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/governance_invariants"
    }
  ],
  "$defs": {
    "requirement_type": {
      "type": "string",
      "enum": [
        "content_requirement",
        "academic_requirement",
        "academic_quality",
        "required_experiment",
        "cross_disciplinary_practice"
      ]
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "draft",
        "candidate",
        "reviewed",
        "active",
        "deprecated",
        "merged",
        "superseded"
      ]
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending_review",
        "approved",
        "rejected"
      ]
    },
    "governance_invariants": {
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "candidate"
              }
            }
          },
          "then": {
            "properties": {
              "review_status": {
                "const": "pending_review"
              },
              "production_eligible": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "review_status": {
                "const": "pending_review"
              }
            }
          },
          "then": {
            "properties": {
              "production_eligible": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "production_eligible": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "active"
              },
              "review_status": {
                "const": "approved"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "active"
              }
            }
          },
          "then": {
            "properties": {
              "review_status": {
                "const": "approved"
              },
              "production_eligible": {
                "const": true
              },
              "evidence_anchors": {
                "items": {
                  "properties": {
                    "source_region_id": {
                      "type": "string",
                      "minLength": 1,
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "requirement_facet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "stable_id",
        "parent_requirement_stable_id",
        "standard_version",
        "official_item_code",
        "requirement_type",
        "source_text",
        "facet_statement",
        "behavior_verb",
        "content_object",
        "condition_or_performance",
        "cognitive_demands",
        "ability_dimensions",
        "knowledge_stable_ids",
        "evidence_anchors",
        "confidence",
        "status",
        "review_status",
        "production_eligible"
      ],
      "properties": {
        "record_type": {
          "const": "requirement_facet"
        },
        "stable_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_requirement_stable_id": {
          "type": "string",
          "minLength": 1
        },
        "standard_version": {
          "type": "string",
          "minLength": 1
        },
        "official_item_code": {
          "type": "string",
          "minLength": 1
        },
        "requirement_type": {
          "$ref": "#/$defs/requirement_type"
        },
        "source_text": {
          "type": "string",
          "minLength": 1,
          "description": "Verified source clause retained separately from the derived facet statement."
        },
        "facet_statement": {
          "type": "string",
          "minLength": 1,
          "description": "Reviewable derived statement in behavior + content object + condition/performance form."
        },
        "behavior_verb": {
          "type": "string",
          "minLength": 1
        },
        "content_object": {
          "type": "string",
          "minLength": 1
        },
        "condition_or_performance": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "cognitive_demands": {
          "type": "array",
          "uniqueItems": true,
          "description": "Version-aware cognitive-demand identifiers.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ability_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "description": "Versioned AbilityDimension stable identifiers.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "knowledge_stable_ids": {
          "type": "array",
          "uniqueItems": true,
          "description": "KnowledgeNode mappings; empty until the separately reviewed crosswalk is available.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_anchors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "evidence_anchor.schema.json"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "$ref": "#/$defs/lifecycle_status"
        },
        "review_status": {
          "$ref": "#/$defs/review_status"
        },
        "production_eligible": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/governance_invariants"
        }
      ]
    }
  }
}
