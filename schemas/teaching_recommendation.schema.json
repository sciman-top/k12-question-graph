{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TeachingRecommendation",
  "description": "A separately governed teaching recommendation. It is not curriculum fact or observed performance evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "recommendation_id", "assessment_target_id", "question_scope", "content", "author_kind", "generation_method", "confidence", "anchor", "status", "review_status", "production_eligible"],
  "properties": {
    "schema_version": { "const": "teaching-recommendation.v1" },
    "recommendation_id": { "type": "string", "format": "uuid" },
    "assessment_target_id": { "type": "string", "format": "uuid" },
    "question_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_key", "scope_type", "question_item_id", "question_block_id"],
      "properties": {
        "scope_key": { "type": "string", "pattern": "^question-scope:v1:" },
        "scope_type": { "enum": ["whole_question", "subquestion", "scoring_point"] },
        "question_item_id": { "type": "string", "format": "uuid" },
        "question_block_id": { "type": ["string", "null"], "format": "uuid" }
      }
    },
    "content": { "type": "string", "minLength": 1 },
    "author_kind": { "enum": ["report_author", "teacher", "ai_candidate", "legacy_candidate"] },
    "generation_method": { "enum": ["source_quote", "rules", "ai", "human"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_document_id", "source_region_id", "source_document_version", "source_document_sha256", "pdf_page_number", "printed_page_number", "section_path", "official_item_code", "text_block_sha256", "evidence_role"],
      "properties": {
        "source_document_id": { "type": "string", "format": "uuid" },
        "source_region_id": { "type": ["string", "null"], "format": "uuid" },
        "source_document_version": { "type": "string", "minLength": 1 },
        "source_document_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "pdf_page_number": { "type": "integer", "minimum": 1 },
        "printed_page_number": { "type": ["integer", "string", "null"] },
        "section_path": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "official_item_code": { "type": ["string", "null"], "minLength": 1 },
        "text_block_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "evidence_role": { "const": "teaching_recommendation_source" }
      }
    },
    "status": { "const": "candidate" },
    "review_status": { "const": "pending_review" },
    "production_eligible": { "const": false }
  },
  "allOf": [
    {
      "if": { "properties": { "author_kind": { "const": "report_author" } } },
      "then": { "properties": { "generation_method": { "const": "source_quote" } } }
    },
    {
      "if": { "properties": { "author_kind": { "const": "ai_candidate" } } },
      "then": { "properties": { "generation_method": { "const": "ai" } } }
    }
  ]
}
