{
  "schemaVersion": 1,
  "unknownPathPolicy": "fail",
  "commandCatalog": [
    { "id": "backend-tests", "command": "dotnet build API test project and referenced API then dotnet test --no-build", "sideEffects": "ignored bin/obj only" },
    { "id": "frontend-tests", "command": "npm build, lint, then test for apps/web", "sideEffects": "ignored dist only" },
    { "id": "worker-tests", "command": "python compileall workers then unittest tests/workers", "sideEffects": "ignored __pycache__ and temporary test files only" },
    { "id": "verification-routing", "command": "selector regression tests", "sideEffects": "tmp/verification only" },
    { "id": "roadmap", "command": "tools/run-roadmap-guard.ps1", "sideEffects": "tmp/verification only" },
    { "id": "reference-basis", "command": "tools/run-reference-basis-guard.ps1", "sideEffects": "tmp/verification only" },
    { "id": "script-quality", "command": "tools/run-script-quality-sweep.ps1 with tmp report", "sideEffects": "tmp/verification only" },
    { "id": "evidence-index", "command": "tools/run-evidence-index-guard.ps1 with tmp report", "sideEffects": "tmp/verification only" }
  ],
  "pathRules": [
    { "pattern": "apps/api/Data/Migrations/*", "owner": "operations", "profile": "Slice", "commands": ["backend-tests"], "reason": "CI verifies migration compilation; stateful compatibility and rollback stay explicit Release work" },
    { "pattern": "tools/backup.ps1", "owner": "operations", "profile": "Slice", "commands": ["script-quality"], "reason": "CI parses the changed backup script; restore rehearsal stays explicit Release work" },
    { "pattern": "tools/restore.ps1", "owner": "operations", "profile": "Slice", "commands": ["script-quality"], "reason": "CI parses the changed restore script; restore rehearsal stays explicit Release work" },
    { "pattern": "apps/api/*", "owner": "api", "profile": "Slice", "commands": ["backend-tests"], "reason": "API implementation or contract changed" },
    { "pattern": "tests/api/*", "owner": "api", "profile": "Slice", "commands": ["backend-tests"], "reason": "API regression coverage changed" },
    { "pattern": "apps/web/*", "owner": "web", "profile": "Slice", "commands": ["frontend-tests"], "reason": "teacher or admin web behavior changed" },
    { "pattern": "workers/*", "owner": "document-worker", "profile": "Slice", "commands": ["worker-tests"], "reason": "document worker changed" },
    { "pattern": "tests/workers/*", "owner": "document-worker", "profile": "Slice", "commands": ["worker-tests"], "reason": "worker regression coverage changed" },
    { "pattern": "tests/fixtures/*", "owner": "document-worker", "profile": "Slice", "commands": ["worker-tests"], "reason": "worker fixture changed" },
    { "pattern": "tests/golden-import/*", "owner": "document-worker", "profile": "Slice", "commands": ["worker-tests"], "reason": "golden import fixture changed" },
    { "pattern": "tests/e2e/*", "owner": "web", "profile": "Slice", "commands": ["frontend-tests"], "reason": "browser fixture changed" },
    { "pattern": "tools/run-verification.ps1", "owner": "verification", "profile": "Slice", "commands": ["verification-routing", "script-quality"], "reason": "canonical verifier changed" },
    { "pattern": "tools/verification/*", "owner": "verification", "profile": "Slice", "commands": ["verification-routing", "script-quality"], "reason": "verification routing changed" },
    { "pattern": "configs/verification/*", "owner": "verification", "profile": "Slice", "commands": ["verification-routing"], "reason": "verification routing policy changed" },
    { "pattern": "schemas/verification/evidence-index.schema.json", "owner": "evidence", "profile": "Slice", "commands": ["evidence-index"], "reason": "current evidence index schema changed" },
    { "pattern": "schemas/verification/*", "owner": "verification", "profile": "Slice", "commands": ["verification-routing"], "reason": "verification-only schema changed" },
    { "pattern": "tests/verification/*", "owner": "verification", "profile": "Slice", "commands": ["verification-routing"], "reason": "verification routing regression changed" },
    { "pattern": ".github/workflows/*", "owner": "verification", "profile": "Slice", "commands": ["verification-routing"], "reason": "CI verification entry changed" },
    { "pattern": "tools/README.md", "owner": "reference-basis", "profile": "Slice", "commands": ["reference-basis"], "reason": "reference and operator navigation changed" },
    { "pattern": "tasks/reference-basis-*", "owner": "reference-basis", "profile": "Slice", "commands": ["reference-basis"], "reason": "reference policy or module mapping changed" },
    { "pattern": "docs/26_References.md", "owner": "reference-basis", "profile": "Slice", "commands": ["reference-basis"], "reason": "reference source documentation changed" },
    { "pattern": "tools/*", "owner": "tooling", "profile": "Slice", "commands": ["script-quality"], "reason": "repo-local script changed" },
    { "pattern": "tasks/*", "owner": "roadmap", "profile": "Slice", "commands": ["roadmap"], "reason": "machine task truth changed" },
    { "pattern": "docs/evidence/*", "owner": "evidence", "profile": "Slice", "commands": ["evidence-index"], "reason": "tracked evidence metadata changed" },
    { "pattern": "docs/*", "owner": "documentation", "profile": "Slice", "commands": [], "reason": "gate_na: documentation-only change" },
    { "pattern": "runbooks/*", "owner": "documentation", "profile": "Slice", "commands": [], "reason": "gate_na: operator documentation-only change" },
    { "pattern": "schemas/*", "owner": "schema", "profile": "Slice", "commands": ["backend-tests", "worker-tests"], "reason": "shared schema changed" },
    { "pattern": "configs/*", "owner": "configuration", "profile": "Slice", "commands": ["script-quality"], "reason": "runtime or policy configuration changed" },
    { "pattern": "sources/*", "owner": "reference-basis", "profile": "Slice", "commands": ["reference-basis"], "reason": "reference basis changed" },
    { "pattern": "*.md", "owner": "documentation", "profile": "Slice", "commands": [], "reason": "gate_na: documentation-only change" },
    { "pattern": "AGENTS.md", "owner": "documentation", "profile": "Slice", "commands": [], "reason": "gate_na: execution contract text only" }
  ]
}
