{
  "schemaVersion": 1,
  "sourceScript": "tools/run-gates.ps1",
  "expectedStepCount": 235,
  "allowedProfiles": ["Quick", "Slice", "Release", "Onsite"],
  "quickStepNames": [
    "backend build",
    "backend tests",
    "frontend host-local debris guard",
    "frontend build",
    "frontend lint",
    "frontend tests",
    "worker python tests"
  ],
  "futureTriggerOnlyNameRegex": "^(q00[1-5]|r00[1-7]|ns11|ns12)",
  "ownerRules": [
    { "pattern": "frontend| ui |teacher home|review workbench|admin.*panel", "owner": "web" },
    { "pattern": "worker|document|ocr|formula|docx|pdf", "owner": "document-worker" },
    { "pattern": "paper|blueprint|basket|export", "owner": "paper-export" },
    { "pattern": "score|analysis|commentary", "owner": "score-analysis" },
    { "pattern": "backup|restore|installer|upgrade|service|offline|recovery", "owner": "operations" },
    { "pattern": "ai |model|prompt|provider|suggestion", "owner": "ai" },
    { "pattern": "curriculum|knowledge|real00|guangzhou|evidence", "owner": "knowledge-evidence" },
    { "pattern": "backend|api |question|source region|migration", "owner": "api" }
  ],
  "triggerPathsByOwner": {
    "api": ["apps/api/**", "tests/api/**", "schemas/**"],
    "web": ["apps/web/**"],
    "document-worker": ["workers/document/**", "tests/workers/**"],
    "paper-export": ["apps/api/**", "apps/web/src/ui/Paper*", "tools/*paper*", "tools/*export*"],
    "score-analysis": ["apps/api/**", "apps/web/src/ui/*Score*", "apps/web/src/ui/*Analysis*", "tools/*score*", "tools/*analysis*"],
    "operations": ["tools/**", "configs/**", "apps/api/Data/Migrations/**"],
    "ai": ["apps/api/**", "workers/**", "configs/ai/**", "schemas/ai/**"],
    "knowledge-evidence": ["apps/api/**", "apps/web/**", "workers/**", "schemas/**", "sources/**", "tasks/**"],
    "governance": ["tools/**", "tasks/**", "docs/**", "configs/**", "schemas/**"]
  }
}
