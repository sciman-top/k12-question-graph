{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "KqgPaths": {
    "DataRoot": "D:\\KQG_Data",
    "FileStoreRoot": "D:\\KQG_Data\\file_store",
    "BackupRoot": "D:\\KQG_Backups",
    "LogsRoot": "D:\\KQG_Data\\logs",
    "CacheRoot": "D:\\KQG_Data\\cache"
  },
  "ConnectionStrings": {
    "KqgDatabase": "Host=127.0.0.1;Port=5432;Database=k12_question_graph;Username=postgres"
  },
  "PythonWorker": {
    "PythonExecutable": "python",
    "DocumentWorkerScript": "worker\\document\\worker.py",
    "TimeoutSeconds": 20
  },
  "AiRouting": {
    "Version": "d001.business-task-routing.v3",
    "AllowRealModelCalls": false,
    "DefaultMode": "balanced",
    "PromptVersion": "prompt.d001.draft-test.v1",
    "Routes": {
      "file_dedup": {
        "Handler": "rule",
        "Stage": "ingest",
        "ModelRole": "local_deterministic",
        "ModelName": "none",
        "ReasoningEffort": "none"
      },
      "source_material_ingest": {
        "Handler": "rule",
        "Stage": "ingest",
        "ModelRole": "local_deterministic",
        "ModelName": "none",
        "ReasoningEffort": "none"
      },
      "ordinary_ocr": {
        "Handler": "local_ocr",
        "Stage": "ingest",
        "ModelRole": "local_deterministic",
        "ModelName": "none",
        "ReasoningEffort": "none"
      },
      "document_layout": {
        "Handler": "local_document_parser",
        "Stage": "ingest",
        "ModelRole": "local_deterministic",
        "ModelName": "none",
        "ReasoningEffort": "none"
      },
      "question_region_detection": {
        "Handler": "llm",
        "Stage": "cutting",
        "ModelRole": "bulk_structuring",
        "ModelName": "gpt-5.6-terra",
        "ReasoningEffort": "high",
        "ModelTier": "medium",
        "EscalateToRole": "visual_document",
        "EscalateToModel": "gpt-5.6-terra",
        "EscalateReasoningEffort": "xhigh",
        "EscalateInHighAccuracy": true,
        "EscalationSignals": ["cross_page", "shared_visual", "formula_or_table"],
        "StructuredOutputSchema": "schemas/ai/crop_candidate_generation.schema.json",
        "RequireHumanReviewBelowConfidence": 0.9
      },
      "crop_candidate_generation": {
        "Handler": "llm",
        "Stage": "cutting",
        "ModelRole": "visual_document",
        "ModelName": "gpt-5.6-terra",
        "ReasoningEffort": "xhigh",
        "ModelTier": "strong",
        "EscalateToRole": "semantic_decision",
        "EscalateToModel": "gpt-5.6-sol",
        "EscalateReasoningEffort": "xhigh",
        "EscalationSignals": ["semantic_conflict", "source_evidence_conflict"],
        "StructuredOutputSchema": "schemas/ai/crop_candidate_generation.schema.json",
        "RequireHumanReviewBelowConfidence": 0.9
      },
      "crop_execution": {
        "Handler": "rule",
        "Stage": "cutting",
        "ModelRole": "local_deterministic",
        "ModelName": "none",
        "ReasoningEffort": "none"
      },
      "question_extraction": {
        "Handler": "llm",
        "Stage": "structuring",
        "ModelRole": "bulk_structuring",
        "ModelName": "gpt-5.6-terra",
        "ReasoningEffort": "high",
        "ModelTier": "medium",
        "EscalateToRole": "general_semantics",
        "EscalateToModel": "gpt-5.6-sol",
        "EscalateReasoningEffort": "medium",
        "EscalateInHighAccuracy": true,
        "EscalationSignals": ["cross_page", "semantic_conflict", "source_evidence_conflict"],
        "StructuredOutputSchema": "schemas/ai/question_extraction.schema.json",
        "RequireHumanReviewBelowConfidence": 0.85
      },
      "knowledge_tagging": {
        "Handler": "llm",
        "Stage": "tagging",
        "ModelRole": "bulk_structuring",
        "ModelName": "gpt-5.6-terra",
        "ReasoningEffort": "high",
        "ModelTier": "medium",
        "EscalateToRole": "general_semantics",
        "EscalateToModel": "gpt-5.6-sol",
        "EscalateReasoningEffort": "medium",
        "EscalateInHighAccuracy": true,
        "EscalationSignals": ["semantic_conflict", "source_evidence_conflict"],
        "StructuredOutputSchema": "schemas/ai/knowledge_mapping.schema.json",
        "RequireHumanReviewBelowConfidence": 0.8,
        "Batchable": true
      },
      "knowledge_mapping_review": {
        "Handler": "llm",
        "Stage": "tagging",
        "ModelRole": "semantic_decision",
        "ModelName": "gpt-5.6-sol",
        "ReasoningEffort": "xhigh",
        "ModelTier": "strong",
        "StructuredOutputSchema": "schemas/ai/knowledge_mapping.schema.json",
        "RequireHumanReviewBelowConfidence": 0.95
      },
      "natural_language_paper_request": {
        "Handler": "llm",
        "Stage": "paper_request",
        "ModelRole": "bulk_structuring",
        "ModelName": "gpt-5.6-terra",
        "ReasoningEffort": "high",
        "ModelTier": "medium",
        "EscalateToRole": "general_semantics",
        "EscalateToModel": "gpt-5.6-sol",
        "EscalateReasoningEffort": "medium",
        "EscalateInHighAccuracy": true,
        "EscalationSignals": ["multiple_constraints", "semantic_conflict"],
        "StructuredOutputSchema": "schemas/ai/natural_language_paper_request.schema.json",
        "RequireHumanReviewBelowConfidence": 0.85
      },
      "paper_constraint_check": {
        "Handler": "rule",
        "Stage": "assembly",
        "ModelRole": "local_deterministic",
        "ModelName": "none",
        "ReasoningEffort": "none"
      },
      "paper_composition": {
        "Handler": "llm",
        "Stage": "assembly",
        "ModelRole": "semantic_decision",
        "ModelName": "gpt-5.6-sol",
        "ReasoningEffort": "xhigh",
        "ModelTier": "strong",
        "StructuredOutputSchema": "schemas/ai/paper_composition_review.schema.json",
        "RequireHumanReviewBelowConfidence": 0.95
      },
      "visual_asset_review": {
        "Handler": "llm",
        "Stage": "review",
        "ModelRole": "visual_document",
        "ModelName": "gpt-5.6-terra",
        "ReasoningEffort": "xhigh",
        "ModelTier": "strong",
        "StructuredOutputSchema": "schemas/ai/visual_asset_review.schema.json",
        "RequireHumanReviewBelowConfidence": 0.95
      },
      "paper_visual_review": {
        "Handler": "llm",
        "Stage": "review",
        "ModelRole": "visual_document",
        "ModelName": "gpt-5.6-terra",
        "ReasoningEffort": "xhigh",
        "ModelTier": "strong",
        "StructuredOutputSchema": "schemas/ai/visual_asset_review.schema.json",
        "RequireHumanReviewBelowConfidence": 0.95
      },
      "answer_verification": {
        "Handler": "llm",
        "Stage": "verification",
        "ModelRole": "general_semantics",
        "ModelName": "gpt-5.6-sol",
        "ReasoningEffort": "medium",
        "ModelTier": "medium",
        "EscalateToRole": "semantic_decision",
        "EscalateToModel": "gpt-5.6-sol",
        "EscalateReasoningEffort": "xhigh",
        "EscalateInHighAccuracy": true,
        "EscalationSignals": ["formal_exam", "semantic_conflict", "source_evidence_conflict"],
        "StructuredOutputSchema": "schemas/ai/answer_verification.schema.json",
        "RequireHumanReviewBelowConfidence": 0.9
      },
      "export_preflight": {
        "Handler": "rule",
        "Stage": "export",
        "ModelRole": "local_deterministic",
        "ModelName": "none",
        "ReasoningEffort": "none"
      }
    }
  },
  "AdminInternalGuard": {
    "ApiKey": "",
    "AllowUnguardedDraftTest": false
  },
  "AdminInternalRoleAudit": {
    "Enabled": true,
    "RequireRoleHeader": true,
    "RequireOperatorIdHeader": true,
    "EnableAuditLog": true,
    "AuditLogFileName": "admin-internal-audit.jsonl"
  },
  "AllowedHosts": "*"
}
