{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AdminInternalGuard": {
    "ApiKey": "",
    "AllowUnguardedDraftTest": true,
    "TrustedRole": "admin",
    "TrustedOperatorId": "vite-dev-proxy",
    "RequireHttpsForRemoteSessions": true,
    "SessionLifetimeMinutes": 480
  },
  "AdminInternalRoleAudit": {
    "Enabled": true,
    "EnableAuditLog": true,
    "AuditLogFileName": "admin-internal-audit.jsonl"
  },
  "PythonWorker": {
    "DocumentWorkerScript": "..\\..\\workers\\document\\worker.py"
  }
}
